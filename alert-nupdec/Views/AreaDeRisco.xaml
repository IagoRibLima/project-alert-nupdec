<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alert_nupdec.Views.AreaDeRisco"
             Title="AreaDeRisco"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <Grid RowDefinitions="Auto, *">
        <!--Botão de voltar-->
        <ImageButton Grid.Row="0"
                     Source="voltar.png"                                        
                     Margin="8"
                     Padding="12"
                     VerticalOptions="Start"
                     HorizontalOptions="Start"
                     BackgroundColor="#1848a0"
                     Clicked="ButtonVoltar"
                     HeightRequest="50"
                     WidthRequest="50"
                     CornerRadius="15"/>

        <!--Título da página-->
        <Label Text="Cadastrar Área de Risco"
                                   TextColor="#1848a0"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center"
                                   Margin="50,20,0,15"/>

        <!--ScrollView da Area de Risco-->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout VerticalOptions="Start"
                     Padding="60,0,60,60"
                     Spacing="10">



                <!--Campo da Nome da Área-->
                <Label Text="Nome da área"
                           TextColor="#1848a0"
                           FontAttributes="Bold"
                           FontSize="16"
                           Margin="10,2"/>
                <Border StrokeThickness="1"
                            BackgroundColor="#e8ecee"
                            Padding="8">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                    Offset="5,5"
                                    Radius="10"
                                    Opacity="0.3"/>
                    </Border.Shadow>

                    <Entry x:Name="txt_nomeArea"
                               Placeholder="Ex: Morro do Desespero, Vila do Sol, Setor B"
                               TextColor="DarkSlateGray"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"/>
                </Border>

                <!--Campo de Endereço Completo-->
                <Label Text="Endereço completo"
                           TextColor="#1848a0"
                           FontAttributes="Bold"
                           FontSize="16"
                           Margin="10,2"/>
                <Border StrokeThickness="1"
                            BackgroundColor="#e8ecee"
                            Padding="8">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                    Offset="5,5"
                                    Radius="10"
                                    Opacity="0.3"/>
                    </Border.Shadow>

                    <Entry x:Name="txt_enderecoCompleto"
                               Placeholder="Ex: Rua Principal, 150 - Bairro das Fontes"
                               TextColor="DarkSlateGray"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"/>
                </Border>

                <!--Campo de CEP-->
                <Label Text="CEP"
                           TextColor="#1848a0"
                           FontAttributes="Bold"
                           FontSize="16"
                           Margin="10,2"/>
                <Border StrokeThickness="1"
                            BackgroundColor="#e8ecee"
                            Padding="8">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                    Offset="5,5"
                                    Radius="10"
                                    Opacity="0.3"/>
                    </Border.Shadow>

                    <Entry x:Name="txt_cep"
                               Placeholder="00000-000"
                               Keyboard="Numeric" 
                               MaxLength="9"
                               TextColor="DarkSlateGray"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"/>
                </Border>

                <!--Campo de Tipo de Problema-->
                <Label Text="Tipo de problema"
                           TextColor="#1848a0"
                           FontAttributes="Bold"
                           FontSize="16"
                           Margin="10,2"/>

                <Picker x:Name="picker_tipoProblema"
                            SelectedIndexChanged="picker_Select"
                            TextColor="#1848a0"
                            BackgroundColor="#e8ecee"
                            FontSize="15">
                    <Picker.Items>
                        <x:String>Selecione o tipo de problema</x:String>
                        <x:String>Inundação / Alagamento</x:String>
                        <x:String>Deslizamento de Terra / Movimento de Massa</x:String>
                        <x:String>Erosão (Buraco ou Cava no solo)</x:String>
                        <x:String>Rachadura Grave em Estrutura</x:String>
                        <x:String>Queda de Árvore ou Rocha</x:String>
                        <x:String>Outro</x:String>
                    </Picker.Items>
                </Picker>

                <!--Campo de Descrição do Problema-->
                <Label Text="Descrição do problema"
                       TextColor="#1848a0"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="10,2"/>

                <!-- Define uma altura mínima para o Editor -->
                <Border  HeightRequest="100">
                    <Editor x:Name="txt_descricao"
                            Placeholder="Ex: Água subindo rápido (altura da cintura), muro de contenção acabou de ceder..."
                            TextColor="DarkSlateGray"
                            BackgroundColor="Transparent"/>
                </Border>

                <!--Campo de Risco Imediato-->
                <Label Text="Risco Imediato"
                       TextColor="#1848a0"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="10,2"/>
                <HorizontalStackLayout>
                    <Label Text="Há risco imediato?"
                           TextColor="#1848a0"
                           FontSize="14"
                           Margin="10,2"/>
                    <Border Stroke="#a6a6a6">
                        <CheckBox x:Name="chkRiscoImediato" Color="#1848a0" 
                              BackgroundColor="#a6a6a6"
                              Margin="0,-10,0,0"/>
                    </Border>
                    <Label Text="Sim (marcado) / Não (desmarcado)"
                           TextColor="#1848a0"
                           Margin="-5,3,0,0"/>

                </HorizontalStackLayout>

                <!--Quarto campo do formulário-->
                <Label Text="Anexar foto "
                       TextColor="#1848a0"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="10,2"/>
                <Border StrokeThickness="3"
                        BackgroundColor="Transparent"
                        Padding="0"
                        Stroke="#1848a0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#1848a0"
                                Offset="5,5"
                                Radius="10"
                                Opacity="0"/>
                    </Border.Shadow>

                    <HorizontalStackLayout HorizontalOptions="Center">
                        <ImageButton Source="camera.png"                                        
                                     Margin="8"
                                     Padding="12"
                                     VerticalOptions="Start"
                                     HorizontalOptions="Start"
                                     BackgroundColor="Transparent"
                                     Clicked="ButtonSelecionarImagem"
                                     HeightRequest="50"
                                     WidthRequest="50"
                                     CornerRadius="15"/>

                        <Label Text="Adicionar Foto"
                               TextColor="#1848a0"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="8"/>

                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ButtonSelecionarImagem"/>
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ButtonSelecionarImagem"/>
                    </Border.GestureRecognizers>
                </Border>

                <!--Botão de cadastrar-->
                <Border BackgroundColor="#ff751f"
                            Padding="4"
                            StrokeThickness="1"
                            Margin="0,20,0,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ButtonCadastrar" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                                    Offset="2,0"
                                    Radius="10"
                                    Opacity="0.1"/>
                    </Border.Shadow>
                    <Button Text="Cadastrar"
                                TextColor="#e8ecee"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                Clicked="ButtonCadastrar"
                                BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>