<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alert_nupdec.Views.Configuracoes"
             Title="Configuracoes"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <Grid RowDefinitions="Auto, Auto">
        <!-- Barra azul superior -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *" 
              BackgroundColor="#1848a0" 
              Padding="10,15">

            <!-- Botão Voltar -->
            <ImageButton Grid.Column="0" 
                         Grid.Row="0"
                         Source="voltar.png" 
                         Clicked="ButtonVoltar"
                         Margin="0"
                         BackgroundColor="Transparent"
                         HeightRequest="30"
                         WidthRequest="30"
                         VerticalOptions="Center"
                         HorizontalOptions="Start"/>

            <!-- Título da Página -->
            <Label Grid.Column="1" 
                   Grid.Row="0"
                   Text="Configurações" 
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   Margin="0,0,30,0"/>
        </Grid>

        <!--ScrollView das Configurações-->
        <ScrollView Grid.Row="1"
                    Padding="10,0"
                    Margin="10,20">
            <VerticalStackLayout>
                <Border HeightRequest="80"
                        WidthRequest="80"
                        StrokeShape="RoundRectangle 40"
                        Margin="10,0"
                        VerticalOptions="Center">
                    <Image x:Name="img_perfil"
                           Aspect="AspectFill"/>
                </Border>

                <Label Text="Dados da Conta"
                       TextColor="#1848a0"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"
                       Margin="0,30,0,0"/>

                <!--Label para editar dados-->
                <Label Text="Editar"
                       HorizontalOptions="End"
                       TextColor="DarkSlateGray"
                       Margin="10,0">
                    
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ButtonEditar" />
                    </Label.GestureRecognizers>
                </Label>

                <!--Label nome usuario-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="Nome: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>

                    <Label x:Name="lbl_usuario" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>

                <!--Label email-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="Email: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>

                    <Label x:Name="lbl_email" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>

                <!--Label cpf-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="CPF: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>

                    <Label x:Name="lbl_cpf" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>

                <!--Label telefone-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="Telefone: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>

                    <Label x:Name="lbl_telefone" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>

                <!--Label unidade-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="Unidade: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>

                    <Label x:Name="lbl_unidade" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>

                <!--Label senha-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="Senha: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>
        
                    <Label x:Name="lbl_senha" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>
                                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>



