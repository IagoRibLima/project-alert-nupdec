<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alert_nupdec.Views.EditarDados"
             Title="EditarDados"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <Grid RowDefinitions="Auto, Auto">
        <!--Botão de voltar-->
        <ImageButton Grid.Row="0"
                 Source="voltar.png"                                        
                 Margin="8"
                 Padding="12"
                 VerticalOptions="Start"
                 HorizontalOptions="Start"
                 BackgroundColor="#1848a0"
                 Clicked="ButtonVoltar"
                 HeightRequest="50"
                 WidthRequest="50"
                 CornerRadius="15"/>

        <Label Text="Configuração da Conta"
           HorizontalOptions="Center"
           HorizontalTextAlignment="Center"
           VerticalOptions="Center"
           TextColor="#1848a0"
           FontSize="22"
           FontAttributes="Bold"
           Margin="0,20"/>

        <!--ScrollView das Configurações-->
        <ScrollView Grid.Row="1"
                    Padding="10,0"
                    Margin="10,20">
            <VerticalStackLayout>
                <Border Grid.Column="0"
                        HeightRequest="80"
                        WidthRequest="80"
                        StrokeShape="RoundRectangle 40"
                        Margin="10,0"
                        VerticalOptions="Center">
                    <Image Source="usuario.png" Aspect="AspectFill" />
                </Border>

                <Label Text="Alterar Dados da Conta"
                       TextColor="#1848a0"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"
                       Padding="10,0"
                       Margin="0,30,0,15"/>

                <!--Label email-->
                <Grid ColumnDefinitions="Auto, *" 
                  ColumnSpacing="10"
                  Margin="0,10">

                    <Label Grid.Column="0" 
                       Text="Email: " 
                       TextColor="#1848a0"
                       FontSize="15"
                       VerticalOptions="Center"/>

                    <Border Grid.Column="1"
                        StrokeThickness="1"
                        BackgroundColor="#e8ecee"
                        Padding="0"
                        HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                                Offset="5,5"
                                Radius="10"
                                Opacity="0.3"/>
                        </Border.Shadow>

                        <Entry x:Name="txt_novoemail"
                               Placeholder="Digite seu novo email"
                               TextColor="DarkSlateGray"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"/>
                    </Border>
                </Grid>

                <!--Label telefone-->
                <Grid ColumnDefinitions="Auto, *" 
                      ColumnSpacing="10"
                      Margin="0,10">

                    <Label Grid.Column="0" 
                           Text="Telefone: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           VerticalOptions="Center"/>

                    <Border Grid.Column="1"
                            StrokeThickness="1"
                            BackgroundColor="#e8ecee"
                            Padding="0"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Offset="5,5"
                                    Radius="10"
                                    Opacity="0.3"/>
                        </Border.Shadow>

                        <Entry x:Name="txt_novotelefone"
                               Placeholder="Digite seu novo telefone"
                               TextColor="DarkSlateGray"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"/>
                    </Border>
                </Grid>

                <!--Label senha-->
                <Grid ColumnDefinitions="Auto, *" 
                      ColumnSpacing="10"
                      Margin="0,10">

                    <Label Grid.Column="0" 
                           Text="Senha: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           VerticalOptions="Center"/>

                    <Border Grid.Column="1"
                            StrokeThickness="1"
                            BackgroundColor="#e8ecee"
                            Padding="0"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Offset="5,5"
                                    Radius="10"
                                    Opacity="0.3"/>
                        </Border.Shadow>

                        <Entry x:Name="txt_novasenha"
                               Placeholder="Digite sua nova senha"
                               TextColor="DarkSlateGray"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"/>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>