<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:alert_nupdec.Models"
             x:Class="alert_nupdec.Views.VisualizarUnidade"
             Title="VisualizarUnidade"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <!-- Estrutura principal: Header (Auto) e Conteúdo (Resto: *) -->
    <Grid RowDefinitions="Auto, *">
        <!-- Barra azul superior -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *" 
              BackgroundColor="#1848a0" 
              Padding="10,15">

            <!-- Botão Voltar -->
            <ImageButton Grid.Column="0" 
                 Grid.Row="0"
                 Source="voltar.png" 
                 Clicked="ButtonVoltar"
                 Margin="0"
                 BackgroundColor="Transparent"
                 HeightRequest="30"
                 WidthRequest="30"
                 VerticalOptions="Center"
                 HorizontalOptions="Start"/>

            <!-- Título da Página -->
            <Label Grid.Column="1" Grid.Row="0"
                   Text="Gerenciar Unidades" 
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   Margin="0,0,30,0"/>
        </Grid>

        <ScrollView Grid.Row="1"
                    Padding="30,20">
            <CollectionView 
                x:Name="lista_unidade" 
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label Text="Nenhuma unidade."
                HorizontalOptions="Center"
                VerticalOptions="Center"
                TextColor="Gray"
                FontAttributes="Italic"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Unidade">

                        <Border Margin="15, 8" 
                    Padding="15"
                    BackgroundColor="White" 
                    Stroke="#e8ecee"
                    StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Opacity="0"/>
                            </Border.Shadow>

                            <!-- Conteúdo do Card -->
                            <VerticalStackLayout Spacing="8">

                                <!-- Nome da Área e Status (Cor Risco) -->
                                <StackLayout Orientation="Horizontal" Spacing="10">
                                    <Label Text="{Binding nome, StringFormat='Nome: {0}'}"
                                       FontAttributes="Bold" 
                                       TextColor="#1848a0" 
                                       FontSize="18"
                                       VerticalOptions="Center"/>
                                </StackLayout>

                                <BoxView HeightRequest="1" Color="#e8ecee" Margin="0, 3"/>

                                <!-- Detalhes do Problema e Endereço -->
                                <Label Text="{Binding enderecoCompleto, StringFormat='Endereço: {0}'}"
                                    MaxLines="2"
                                   TextColor="DarkSlateGray" 
                                   FontSize="13"/>

                                <Label Text="{Binding cep, StringFormat='CEP: {0}'}" 
                                   TextColor="DarkSlateGray" 
                                   MaxLines="2"
                                   FontSize="13"/>

                                <Label Text="{Binding descricaoUnidade, StringFormat='Descrição: {0}'}" 
                                   TextColor="DarkSlateGray" 
                                   MaxLines="2" 
                                   LineBreakMode="TailTruncation"
                                   FontSize="13"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </Grid>

</ContentPage>