<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:alert_nupdec.Models"
             x:Class="alert_nupdec.Views.VizualizarVoluntario"
             Title="VizualizarVoluntario"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <Grid RowDefinitions="Auto, *">
        <!-- Barra azul superior -->
        <Grid Grid.Row="0" 
          ColumnDefinitions="Auto, *" 
          BackgroundColor="#1848a0" 
          Padding="10,15">

            <!-- Botão Voltar -->
            <ImageButton Grid.Column="0" 
                     Grid.Row="0"
                     Source="voltar.png" 
                     Clicked="ButtonVoltar"
                     Margin="0"
                     BackgroundColor="Transparent"
                     HeightRequest="30"
                     WidthRequest="30"
                     VerticalOptions="Center"
                     HorizontalOptions="Start"/>

            <!-- Título da Página -->
            <Label Grid.Column="1" 
               Grid.Row="0"
               Text="Gerenciar Voluntarios" 
               HorizontalOptions="Center"
               VerticalOptions="Center"
               TextColor="White"
               FontSize="22"
               FontAttributes="Bold"
               Margin="0,0,30,0"/>
        </Grid>

        <!--ScrollView do Feed-->
        <ScrollView Grid.Row="1"
                    Padding="30,20">
            <CollectionView Grid.Row="1"
                            x:Name="lista_usuario"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                   ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label Text="Nenhuma voluntário."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           FontAttributes="Italic"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Usuario">

                        <Border Margin="15, 8" 
            Padding="15"
            BackgroundColor="White" 
            Stroke="#e8ecee"
            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Opacity="0"/>
                            </Border.Shadow>

                            <!-- Conteúdo do Card -->
                            <VerticalStackLayout Spacing="8">

                                <!-- Nome do Voluntario -->
                                <StackLayout Orientation="Horizontal" Spacing="10">
                                    <Label Text="{Binding NomeCompleto, StringFormat='Nome: {0}'}" 
                                   FontAttributes="Bold" 
                                   TextColor="#1848a0" 
                                   FontSize="18"
                                   VerticalOptions="Center"/>
                                </StackLayout>

                                <BoxView HeightRequest="1" Color="#e8ecee" Margin="0, 3"/>

                                <!-- Detalhes dos dados dos voluntarios -->
                                <Label Text="{Binding Email, StringFormat='Email: {0}'}" 
                               TextColor="DarkSlateGray" 
                               FontSize="15"/>

                                <Label Text="{Binding CPF, StringFormat='CPF: {0}'}" 
                               TextColor="DarkSlateGray" 
                               FontSize="13"/>

                                <Label Text="{Binding Telefone, StringFormat='Telefone: {0}'}"
                               TextColor="DarkSlateGray" 
                               MaxLines="2" 
                               LineBreakMode="TailTruncation"
                               FontSize="13"/>
                                <Label Text="{Binding Unidade.nome, StringFormat='Unidade: {0}'}"
                                TextColor="DarkSlateGray" 
                                MaxLines="2" 
                                LineBreakMode="TailTruncation"
                                FontSize="13"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

    </Grid>

</ContentPage>