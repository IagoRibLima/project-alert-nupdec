<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alert_nupdec.Views.RecuperarSenhaAlteracao"
             Title="RecuperarSenhaAlteracao"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <Grid RowDefinitions="Auto, Auto">
        <!-- Barra azul superior -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *" 
              BackgroundColor="#1848a0" 
              Padding="10,15">

            <!-- Botão Voltar -->
            <ImageButton Grid.Column="0" 
                         Grid.Row="0"
                         Source="voltar.png" 
                         Clicked="ButtonVoltar"
                         Margin="0"
                         BackgroundColor="Transparent"
                         HeightRequest="30"
                         WidthRequest="30"
                         VerticalOptions="Center"
                         HorizontalOptions="Start"/>

            <!-- Título da Página -->
            <Label Grid.Column="1" 
                   Grid.Row="0"
                   Text="Recuperar Senha" 
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   Margin="0,0,30,0"/>
        </Grid>

        <!--ScrollView de Recuperar Senha-->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout VerticalOptions="Start"
                                 Padding="60,0,60,60"
                                 Spacing="10">

                <!--Label nome usuario-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="Nome: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>

                    <Label x:Name="lbl_nome" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>

                <!--Label nome usuario-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="Email: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>

                    <Label x:Name="lbl_email" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>

                <!--Label nome usuario-->
                <HorizontalStackLayout Margin="0,10">
                    <Label Text="CPF: " 
                           TextColor="#1848a0"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"/>

                    <Label x:Name="lbl_cpf" 
                           TextColor="DarkSlateGray"
                           FontSize="15"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           Margin="10,0"/>
                </HorizontalStackLayout>

                <!--Campo de Senha-->
                <Label Text="Nova Senha"
                       TextColor="#1848a0"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,20,0,2"/>
                <Border StrokeThickness="0"
                        BackgroundColor="#e8ecee"
                        Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Opacity="0"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*, Auto" 
                          ColumnSpacing="5">

                        <Entry Grid.Column="0"
                               IsPassword="True"
                               x:Name="txt_senha"
                               Placeholder="Senha"
                               PlaceholderColor="#6170ab"
                               TextColor="DarkSlateGray"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"/>

                        <ImageButton x:Name="btn_senha"
                                     Source="olho_aberto.png"
                                     Clicked="ButtonVerSenha"
                                     Grid.Column="1"
                                     VerticalOptions="Center"
                                     WidthRequest="35"
                                     HeightRequest="35"
                                     Background="Transparent"
                                     Aspect="AspectFit"
                                     BorderWidth="0"
                                     Padding="10"/>
                    </Grid>
                    
                </Border>

                <!--Campo de Confirmar Senha-->
                <Label Text="Confirmar Senha"
                       TextColor="#1848a0"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,2"/>
                <Border StrokeThickness="0"
                        BackgroundColor="#e8ecee"
                        Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Opacity="0"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*, Auto"
                          ColumnSpacing="5">

                        <Entry Grid.Column="0"
                               IsPassword="True"
                               x:Name="txt_confirmarsenha"
                               Placeholder="Confirmar Senha"
                               PlaceholderColor="#6170ab"
                               TextColor="DarkSlateGray"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"/>
                        
                        <ImageButton x:Name="btn_confirmarsenha"
                                     Source="olho_aberto.png"
                                     Clicked="ButtonVerConfirmarSenha"
                                     Grid.Column="1"
                                     VerticalOptions="Center"
                                     WidthRequest="35"
                                     HeightRequest="35"
                                     Background="Transparent"
                                     Aspect="AspectFit"
                                     BorderWidth="0"
                                     Padding="10"/>
                    </Grid>
                   
                </Border>

                <!--Botão de cadastrar-->
                <Border BackgroundColor="#ff751f"
                        Padding="4"
                        StrokeThickness="1"
                        Margin="0,20,0,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ButtonAlterar" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Opacity="0"/>
                    </Border.Shadow>

                    <Button Text="Alterar"
                            TextColor="#e8ecee"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Clicked="ButtonAlterar"
                            BackgroundColor="Transparent"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>