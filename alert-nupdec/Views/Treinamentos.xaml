<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alert_nupdec.Views.Treinamentos"
             Title="Treinamentos"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <Grid RowDefinitions="Auto,*">
        <!-- Barra azul superior -->
        <Grid Grid.Row="0" 
      ColumnDefinitions="Auto, *" 
      BackgroundColor="#1848a0" 
      Padding="10,15">

            <!-- Botão Voltar -->
            <ImageButton Grid.Column="0" 
                 Grid.Row="0"
                 Source="voltar.png" 
                 Clicked="ButtonVoltar"
                 Margin="0"
                 BackgroundColor="Transparent"
                 HeightRequest="30"
                 WidthRequest="30"
                 VerticalOptions="Center"
                 HorizontalOptions="Start"/>

            <!-- Título da Página -->
            <Label Grid.Column="1" 
           Grid.Row="0"
           Text="Treinamentos" 
           HorizontalOptions="Center"
           VerticalOptions="Center"
           TextColor="White"
           FontSize="22"
           FontAttributes="Bold"
           Margin="0,0,30,0"/>
        </Grid>

        <!-- Conteúdo -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="20,10"
                             Spacing="10"
                             Margin="20,20">

            <CollectionView x:Name="lista_treinamentos"
                            SelectionMode="None"
                            Margin="0,10">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                       ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label Text="Nenhum treinamento cadastrado ainda."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           FontAttributes="Italic"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                                BackgroundColor="#e8ecee"
                                Stroke="#1848a0"
                                Margin="0,5"
                                Padding="10"
                                StrokeShape="RoundRectangle 20">
                            <VerticalStackLayout>
                                <Label Text="{Binding Nome}"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="#ff751f"/>
                                <Label Text="{Binding Vaga}"
                                       FontSize="14"
                                       TextColor="#1848a0"/>
                                <Label Text="{Binding Descricao}"
                                       FontSize="14"
                                       TextColor="Gray"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>