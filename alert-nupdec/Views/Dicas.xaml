<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alert_nupdec.Views.Dicas"
             Title="Dicas"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <Grid RowDefinitions="Auto, Auto">
        <Button Grid.Row="0"
                Text="Voltar"
                TextColor="#e8ecee"
                FontSize="15"
                FontAttributes="Bold"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Margin="8"
                Padding="12"
                BackgroundColor="#1848a0"
                Clicked="ButtonVoltar"/>

        <!--ScrollView do Feed-->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10"
                                 Spacing="10">

                <Label Text="Dicas Cadastradas"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="#1848a0"
                       Margin="0,10"/>

                <CollectionView x:Name="lista_dicas"
                            SelectionMode="None"
                            Margin="0,10">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    
                    <CollectionView.EmptyView>
                        <Label Text="Nenhuma dica cadastrada ainda."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           FontAttributes="Italic"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                BackgroundColor="#e8ecee"
                                Stroke="#1848a0"
                                Margin="0,5"
                                Padding="10"
                                StrokeShape="RoundRectangle 20">
                                <VerticalStackLayout>
                                    <Label Text="{Binding NomeDica}"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="#FF751F"/>
                                    <Label Text="{Binding Descricao}"
                                       FontSize="14"
                                       TextColor="Gray"
                                       LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
    
</ContentPage>