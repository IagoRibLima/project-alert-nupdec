<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="alert_nupdec.Views.Dicas"
             Title="Dicas"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#a6a6a6">

    <Grid RowDefinitions="Auto, Auto">
        <!-- Barra azul superior -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *" 
              BackgroundColor="#1848a0" 
              Padding="10,15">

            <!-- Botão Voltar -->
            <ImageButton Grid.Column="0" 
                         Grid.Row="0"
                         Source="voltar.png" 
                         Clicked="ButtonVoltar"
                         Margin="0"
                         BackgroundColor="Transparent"
                         HeightRequest="30"
                         WidthRequest="30"
                         VerticalOptions="Center"
                         HorizontalOptions="Start"/>

            <!-- Título da Página -->
            <Label Grid.Column="1" 
                   Grid.Row="0"
                   Text="Dicas" 
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   Margin="0,0,30,0"/>
        </Grid>

        <!--ScrollView do Feed-->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10"
                                 Spacing="10"
                                 Margin="20,20">

                <CollectionView x:Name="lista_dicas"
                            SelectionMode="None"
                            Margin="0,10">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label Text="Nenhuma dica cadastrada ainda."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           FontAttributes="Italic"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="15, 8" 
                                    Padding="15"
                                    BackgroundColor="White" 
                                    Stroke="#e8ecee"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Border.Shadow>
                                    <Shadow Opacity="0"/>
                                </Border.Shadow>
                                
                                <VerticalStackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <Label Text="{Binding NomeDica, StringFormat='Titulo: {0}'}"
                                                FontAttributes="Bold" 
                                                TextColor="#1848a0" 
                                                FontSize="18"
                                                VerticalOptions="Center"/>
                                    </StackLayout>

                                    <BoxView HeightRequest="1" Color="#e8ecee" Margin="0, 3"/>

                                    <!-- Detalhes do Problema e Endereço -->
                                    <Label Text="{Binding Descricao, StringFormat='Descrição: {0}'}"
                                           MaxLines="2"
                                           TextColor="DarkSlateGray" 
                                           FontSize="13"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
    
</ContentPage>